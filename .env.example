# Copy to .env and fill in. NEVER commit .env or paste its contents into chat.

# --- LLM (Groq, OpenAI-compatible) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Pick current model names from the Groq console model list
LLM_MODEL_CLASSIFY=
LLM_MODEL_SUMMARY=
LLM_TPM=6000
LLM_DAILY_TOKEN_BUDGET=150000

# --- Local dev LLM (Ollama) ---
DEV_LLM_BASE_URL=http://localhost:11434/v1
DEV_LLM_MODEL=qwen2.5:7b-instruct

# --- Storage ---
WAREHOUSE_PATH=data/warehouse.duckdb
RAW_DIR=data/raw

# --- Polite fetching ---
USER_AGENT=eu-reg-tracker/0.1 (contact: you@example.com)
REQUESTS_PER_SECOND=1.0

# --- Deployment ---
HF_TOKEN=
HF_DATASET_REPO=
